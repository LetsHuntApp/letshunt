# Supabase — copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Backblaze B2 — the client needs ONLY the bucket name + S3 endpoint.
# The secret keyID/applicationKey live in the Supabase Edge Function
# (server-side) and are set via `supabase secrets set`, never here.
VITE_B2_BUCKET=letshuntbucket
VITE_B2_ENDPOINT=s3.us-east-005.backblazeb2.com
